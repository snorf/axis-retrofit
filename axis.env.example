# Copy to /etc/axis.env and edit. Read by the systemd unit.

# Camera hostname or IP. Required.
AXIS_HOST=192.0.2.10

# Where uploaded images are written. Must match ReadWritePaths in the unit file.
UPLOAD_DIR=/srv/axis-uploads

# Port the web interface listens on. Do not use 6000, browsers refuse it.
PORT=6001

# Port the camera uploads images to. Defaults to PORT + 1.
#UPLOAD_PORT=6002

# Address the camera should upload to, as "host" or "host:port".
# Leave unset when the server can reach the camera directly on the LAN; it is then
# detected automatically. Set it when running behind NAT or a reverse proxy, because
# the detected address would be the internal one and the camera cannot reach that.
#ADVERTISE_HOST=192.0.2.20:6001

# Path to the file holding one line, username:password, for the camera.
# Relative paths resolve against WorkingDirectory.
#AXIS_CREDS=.axis-creds
